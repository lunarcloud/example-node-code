<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaNodeEditor.App"
             xmlns:local="using:AvaloniaNodeEditor"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Noto Sans Symbols 2 embedded font for ribbon icons -->
            <FontFamily x:Key="NotoSymbolsFont">avares://AvaloniaNodeEditor/Assets/Fonts#Noto Sans Symbols2</FontFamily>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="NodeBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NodeBorderBrush" Color="#B0B8C4"/>
                    <!-- Background for toolbox and properties side panels -->
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="PanelBorderBrush" Color="#CCCCCC"/>
                    <!-- Tint for the canvas area where node positions are negative (x<0 or y<0) -->
                    <SolidColorBrush x:Key="NegativeSpaceBrush" Color="#20FF4444"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NodeBackgroundBrush" Color="#1C2432"/>
                    <SolidColorBrush x:Key="NodeBorderBrush" Color="#2C3445"/>
                    <!-- Background for toolbox and properties side panels -->
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A3C"/>
                    <!-- Tint for the canvas area where node positions are negative (x<0 or y<0) -->
                    <SolidColorBrush x:Key="NegativeSpaceBrush" Color="#30FF4444"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://NodifyM.Avalonia/Styles/ControlStyles.axaml" />
        <StyleInclude Source="avares://AvaloniaUI.Ribbon/Styles/Fluent/AvaloniaRibbon.axaml" />
        <!-- Red border on TextBox when node name is a duplicate -->
        <Style Selector="TextBox.nameError">
            <Setter Property="BorderBrush" Value="Red"/>
        </Style>
    </Application.Styles>
</Application>