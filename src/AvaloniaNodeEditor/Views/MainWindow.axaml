<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaNodeEditor.ViewModels"
        xmlns:models="using:AvaloniaNodeEditor.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nodify="clr-namespace:NodifyM.Avalonia.Controls;assembly=NodifyM.Avalonia"
        xmlns:ribbon="clr-namespace:AvaloniaUI.Ribbon;assembly=AvaloniaUI.Ribbon"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        x:Class="AvaloniaNodeEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Avalonia Node Editor">

    <!-- Connector display templates with labels -->
    <Window.Resources>
        <DataTemplate x:Key="InputConnectorTemplate" x:DataType="vm:ConnectorViewModel">
            <StackPanel Orientation="Horizontal">
                <nodify:Connector IsConnected="{Binding IsConnected}"
                                  Anchor="{Binding Anchor, Mode=TwoWay}" />
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           FontSize="12" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="OutputConnectorTemplate" x:DataType="vm:ConnectorViewModel">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"
                           FontSize="12" />
                <nodify:Connector IsConnected="{Binding IsConnected}"
                                  Anchor="{Binding Anchor, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewGraphCommand}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyNodeCommand}"/>
        <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteNodeCommand}"/>
        <KeyBinding Gesture="Delete" Command="{Binding DeleteNodeCommand}"/>
    </Window.KeyBindings>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Ribbon Toolbar — structure: Ribbon.Tabs > RibbonTab.Groups > RibbonGroupBox > buttons -->
        <ribbon:Ribbon DockPanel.Dock="Top" x:CompileBindings="False">
            <ribbon:Ribbon.Tabs>
                <ribbon:RibbonTab Header="Home">
                    <ribbon:RibbonTab.Groups>

                        <!-- File Group -->
                        <ribbon:RibbonGroupBox Header="File">
                            <ribbon:RibbonButton Content="New"
                                                 Command="{Binding NewGraphCommand}"
                                                 ToolTip.Tip="New graph (Ctrl+N)"
                                                 AutomationProperties.Name="New graph">
                                <ribbon:RibbonButton.LargeIcon>
                                    <TextBlock Text="🗋"
                                               FontFamily="{StaticResource NotoSymbolsFont}"
                                               FontSize="24"/>
                                </ribbon:RibbonButton.LargeIcon>
                            </ribbon:RibbonButton>
                            <ribbon:RibbonButton Content="Save"
                                                 Click="OnSaveClick"
                                                 ToolTip.Tip="Save graph (Ctrl+S)"
                                                 AutomationProperties.Name="Save graph">
                                <ribbon:RibbonButton.LargeIcon>
                                    <TextBlock Text="🖴"
                                               FontFamily="{StaticResource NotoSymbolsFont}"
                                               FontSize="24"/>
                                </ribbon:RibbonButton.LargeIcon>
                            </ribbon:RibbonButton>
                            <ribbon:RibbonButton Content="Open"
                                                 Click="OnLoadClick"
                                                 ToolTip.Tip="Open graph (Ctrl+O)"
                                                 AutomationProperties.Name="Open graph">
                                <ribbon:RibbonButton.LargeIcon>
                                    <TextBlock Text="🗁"
                                               FontFamily="{StaticResource NotoSymbolsFont}"
                                               FontSize="24"/>
                                </ribbon:RibbonButton.LargeIcon>
                            </ribbon:RibbonButton>
                        </ribbon:RibbonGroupBox>

                        <!-- Edit Group -->
                        <ribbon:RibbonGroupBox Header="Edit">
                            <ribbon:RibbonButton Content="Undo"
                                                 Command="{Binding UndoCommand}"
                                                 ToolTip.Tip="Undo last action (Ctrl+Z)"
                                                 AutomationProperties.Name="Undo">
                                <ribbon:RibbonButton.LargeIcon>
                                    <TextBlock Text="↩"
                                               FontFamily="{StaticResource NotoSymbolsFont}"
                                               FontSize="24"/>
                                </ribbon:RibbonButton.LargeIcon>
                            </ribbon:RibbonButton>
                            <ribbon:RibbonButton Content="Redo"
                                                 Command="{Binding RedoCommand}"
                                                 ToolTip.Tip="Redo last undone action (Ctrl+Y)"
                                                 AutomationProperties.Name="Redo">
                                <ribbon:RibbonButton.LargeIcon>
                                    <TextBlock Text="↪"
                                               FontFamily="{StaticResource NotoSymbolsFont}"
                                               FontSize="24"/>
                                </ribbon:RibbonButton.LargeIcon>
                            </ribbon:RibbonButton>
                            <ribbon:RibbonButton Content="Copy"
                                                 Command="{Binding CopyNodeCommand}"
                                                 ToolTip.Tip="Copy selected node (Ctrl+C)"
                                                 AutomationProperties.Name="Copy node">
                                <ribbon:RibbonButton.LargeIcon>
                                    <TextBlock Text="🗐"
                                               FontFamily="{StaticResource NotoSymbolsFont}"
                                               FontSize="24"/>
                                </ribbon:RibbonButton.LargeIcon>
                            </ribbon:RibbonButton>
                            <ribbon:RibbonButton Content="Paste"
                                                 Command="{Binding PasteNodeCommand}"
                                                 ToolTip.Tip="Paste copied node (Ctrl+V)"
                                                 AutomationProperties.Name="Paste node">
                                <ribbon:RibbonButton.LargeIcon>
                                    <TextBlock Text="📋"
                                               FontFamily="{StaticResource NotoSymbolsFont}"
                                               FontSize="24"/>
                                </ribbon:RibbonButton.LargeIcon>
                            </ribbon:RibbonButton>
                            <ribbon:RibbonButton Content="Delete"
                                                 Command="{Binding DeleteNodeCommand}"
                                                 ToolTip.Tip="Delete selected node (Del)"
                                                 AutomationProperties.Name="Delete node">
                                <ribbon:RibbonButton.LargeIcon>
                                    <TextBlock Text="🗑"
                                               FontFamily="{StaticResource NotoSymbolsFont}"
                                               FontSize="24"/>
                                </ribbon:RibbonButton.LargeIcon>
                            </ribbon:RibbonButton>
                        </ribbon:RibbonGroupBox>

                        <!-- View Group -->
                        <ribbon:RibbonGroupBox Header="View">
                            <ribbon:RibbonToggleButton Content="Properties"
                                                        IsChecked="{Binding IsPropertiesPanelVisible}"
                                                        ToolTip.Tip="Show or hide the node properties panel"
                                                        AutomationProperties.Name="Toggle properties panel">
                                <ribbon:RibbonToggleButton.LargeIcon>
                                    <TextBlock Text="🗒"
                                               FontFamily="{StaticResource NotoSymbolsFont}"
                                               FontSize="24"/>
                                </ribbon:RibbonToggleButton.LargeIcon>
                            </ribbon:RibbonToggleButton>
                            <!-- Standard Button with Flyout: RibbonDropDownButton does not expose a Flyout property -->
                            <Button Padding="8,6"
                                    ToolTip.Tip="View and edit the graph name and version"
                                    AutomationProperties.Name="Graph properties">
                                <TextBlock Text="🛈"
                                           FontFamily="{StaticResource NotoSymbolsFont}"
                                           FontSize="24"/>
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel Spacing="6" Width="200" Margin="8">
                                            <TextBlock Text="Graph Properties" FontWeight="SemiBold"/>
                                            <TextBlock Text="Name" FontSize="11"/>
                                            <TextBox Text="{Binding GraphName}" Watermark="Untitled"/>
                                            <TextBlock Text="Version" FontSize="11"/>
                                            <TextBox Text="{Binding GraphVersion}" Watermark="0.0.0"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </ribbon:RibbonGroupBox>

                        <!-- Help Group -->
                        <ribbon:RibbonGroupBox Header="Help">
                            <ribbon:RibbonButton Content="About"
                                                 Click="OnAboutClick"
                                                 ToolTip.Tip="About Avalonia Node Editor"
                                                 AutomationProperties.Name="About">
                                <ribbon:RibbonButton.LargeIcon>
                                    <TextBlock Text="❓"
                                               FontFamily="{StaticResource NotoSymbolsFont}"
                                               FontSize="24"/>
                                </ribbon:RibbonButton.LargeIcon>
                            </ribbon:RibbonButton>
                        </ribbon:RibbonGroupBox>

                    </ribbon:RibbonTab.Groups>
                </ribbon:RibbonTab>

                <!-- Nodes tab replaces the toolbox side panel; drag items to the canvas -->
                <ribbon:RibbonTab Header="Nodes">
                    <ribbon:RibbonTab.Groups>
                        <!-- Sources: nodes that produce/generate data -->
                        <ribbon:RibbonGroupBox Header="Sources">
                            <!-- Gallery extends ListBox; GalleryItem extends ListBoxItem.
                                 Loaded event is used to wire drag handlers safely after
                                 the ribbon tab content is instantiated. -->
                            <ribbon:Gallery Size="Large"
                                            Loaded="OnNodeGalleryLoaded">
                                <ribbon:GalleryItem Content="Number Producer"
                                                    Tag="Number Producer"
                                                    ToolTip.Tip="Number Producer — drag to canvas">
                                    <ribbon:GalleryItem.LargeIcon>
                                        <Border Width="32" Height="32" Background="#4A90D9" CornerRadius="4">
                                            <TextBlock Text="NP" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </ribbon:GalleryItem.LargeIcon>
                                </ribbon:GalleryItem>
                                <ribbon:GalleryItem Content="Random Number Gen."
                                                    Tag="Random Number Generator"
                                                    ToolTip.Tip="Random Number Generator — drag to canvas">
                                    <ribbon:GalleryItem.LargeIcon>
                                        <Border Width="32" Height="32" Background="#E67E22" CornerRadius="4">
                                            <TextBlock Text="RNG" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </ribbon:GalleryItem.LargeIcon>
                                </ribbon:GalleryItem>
                            </ribbon:Gallery>
                        </ribbon:RibbonGroupBox>
                        <!-- Reporters: nodes that display/output data -->
                        <ribbon:RibbonGroupBox Header="Reporters">
                            <ribbon:Gallery Size="Large"
                                            Loaded="OnNodeGalleryLoaded">
                                <ribbon:GalleryItem Content="Number Reporter"
                                                    Tag="Number Reporter"
                                                    ToolTip.Tip="Number Reporter — drag to canvas">
                                    <ribbon:GalleryItem.LargeIcon>
                                        <Border Width="32" Height="32" Background="#27AE60" CornerRadius="4">
                                            <TextBlock Text="NR" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </ribbon:GalleryItem.LargeIcon>
                                </ribbon:GalleryItem>
                            </ribbon:Gallery>
                        </ribbon:RibbonGroupBox>
                        <!-- Processors: nodes that transform/filter data -->
                        <ribbon:RibbonGroupBox Header="Processors">
                            <ribbon:Gallery Size="Large"
                                            Loaded="OnNodeGalleryLoaded">
                                <ribbon:GalleryItem Content="Arithmetic Transform"
                                                    Tag="Arithmetic Transform"
                                                    ToolTip.Tip="Arithmetic Transform — drag to canvas">
                                    <ribbon:GalleryItem.LargeIcon>
                                        <Border Width="32" Height="32" Background="#9B59B6" CornerRadius="4">
                                            <TextBlock Text="AT" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </ribbon:GalleryItem.LargeIcon>
                                </ribbon:GalleryItem>
                                <ribbon:GalleryItem Content="Pass Filter"
                                                    Tag="Pass Filter"
                                                    ToolTip.Tip="Pass Filter — drag to canvas">
                                    <ribbon:GalleryItem.LargeIcon>
                                        <Border Width="32" Height="32" Background="#16A085" CornerRadius="4">
                                            <TextBlock Text="PF" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </ribbon:GalleryItem.LargeIcon>
                                </ribbon:GalleryItem>
                            </ribbon:Gallery>
                        </ribbon:RibbonGroupBox>
                    </ribbon:RibbonTab.Groups>
                </ribbon:RibbonTab>
            </ribbon:Ribbon.Tabs>
        </ribbon:Ribbon>

        <!-- Tab bar: below the ribbon, above the graph canvas -->
        <Border DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <!-- Single horizontal ScrollViewer so the "+" button scrolls with the tabs,
                 always sitting immediately to the right of the last tab. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Height="30">
                <StackPanel Orientation="Horizontal">

                    <!-- Scrollable tab list — no inner scroll, let the outer ScrollViewer handle it -->
                    <ListBox x:Name="TabListBox"
                             x:CompileBindings="False"
                             ItemsSource="{Binding Tabs}"
                             SelectedItem="{Binding ActiveTab}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             VerticalAlignment="Stretch">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="MinWidth" Value="80"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TabViewModel">
                                <Panel VerticalAlignment="Center">
                                    <!-- Context menu for rename / new-tab / delete operations -->
                                    <Panel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="New Tab to the Right"
                                                      Click="OnTabContextMenuNewTab"/>
                                            <MenuItem Header="Rename Tab"
                                                      Click="OnTabContextMenuRename"/>
                                            <MenuItem Header="Delete Tab"
                                                      Click="OnTabContextMenuDelete"/>
                                        </ContextMenu>
                                    </Panel.ContextMenu>

                                    <!-- Normal display -->
                                    <TextBlock Text="{Binding Name}"
                                               IsVisible="{Binding !IsEditing}"
                                               VerticalAlignment="Center"/>

                                    <!-- Inline rename TextBox -->
                                    <TextBox Text="{Binding Name}"
                                             IsVisible="{Binding IsEditing}"
                                             MinWidth="60"
                                             Padding="2,0"
                                             BorderThickness="1"
                                             VerticalAlignment="Center"
                                             LostFocus="OnTabTextBoxLostFocus"
                                             KeyDown="OnTabTextBoxKeyDown"/>
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- "+" button sits immediately after the last tab -->
                    <Button Click="OnAddTabClick"
                            Width="30"
                            Height="30"
                            Padding="0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="Add new tab"
                            AutomationProperties.Name="Add new tab">
                        <TextBlock Text="+"
                                   FontFamily="{StaticResource NotoSymbolsFont}"
                                   FontSize="24"/>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Node canvas -->
                <ColumnDefinition Width="*"/>
                <!-- Right splitter - Auto so it collapses when properties panel is hidden -->
                <ColumnDefinition Width="Auto"/>
                <!-- Properties panel - Auto so it collapses when hidden -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Node editor canvas -->
            <!-- Border provides explicit layout bounds so NodifyEditor's infinite Canvas
                 is clipped to this Grid column and cannot bleed over adjacent panels.
                 The inner Panel holds both the editor and the negative-space overlay. -->
            <Border Grid.Column="0" ClipToBounds="True">
            <Panel>
            <nodify:NodifyEditor x:Name="NodeEditorControl"
                                 x:CompileBindings="False"
                                 ItemsSource="{Binding Nodes}"
                                 Connections="{Binding Connections}"
                                 ConnectionCompletedCommand="{Binding ConnectionCompletedCommand}"
                                 RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                                 DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}">

                <!-- Template for each node on the canvas -->
                <nodify:NodifyEditor.ItemTemplate>
                    <DataTemplate>
                        <nodify:Node Header="{Binding Name}"
                                     Location="{Binding Location, Mode=TwoWay}"
                                     IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                     Input="{Binding Inputs}"
                                     Output="{Binding Outputs}"
                                     InputConnectorTemplate="{StaticResource InputConnectorTemplate}"
                                     OutputConnectorTemplate="{StaticResource OutputConnectorTemplate}">
                            <nodify:Node.ContextMenu>
                                <ContextMenu Opening="OnNodeContextMenuOpening">
                                    <MenuItem Header="Rename"
                                              Click="OnNodeContextMenuRename"/>
                                    <MenuItem Header="Delete"
                                              Click="OnNodeContextMenuDelete"/>
                                    <MenuItem Header="Move To Tab"/>
                                    <MenuItem Header="Properties"
                                              Click="OnNodeContextMenuProperties"/>
                                </ContextMenu>
                            </nodify:Node.ContextMenu>
                        </nodify:Node>
                    </DataTemplate>
                </nodify:NodifyEditor.ItemTemplate>

                <!-- Template for drawn connections -->
                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate>
                        <nodify:Connection Source="{Binding Source.Anchor}"
                                           Target="{Binding Target.Anchor}"
                                           DisconnectCommand="{Binding $parent[nodify:NodifyEditor].RemoveConnectionCommand}" />
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>

                <!-- Template for the in-progress (pending) connection -->
                <nodify:NodifyEditor.PendingConnectionTemplate>
                    <DataTemplate>
                        <nodify:PendingConnection AllowOnlyConnectors="True" />
                    </DataTemplate>
                </nodify:NodifyEditor.PendingConnectionTemplate>
            </nodify:NodifyEditor>

            <!-- Negative-space overlay: tints the canvas area where x<0 or y<0.
                 Non-interactive; positioned and sized in code-behind whenever the
                 viewport pan offset (OffsetX/OffsetY) or the editor bounds change. -->
            <Canvas x:Name="NegativeSpaceCanvas" IsHitTestVisible="False">
                <!-- Left strip: covers the visible negative-X area (left of canvas origin) -->
                <Rectangle x:Name="NegSpaceLeft"
                           Fill="{DynamicResource NegativeSpaceBrush}"
                           IsHitTestVisible="False"
                           IsVisible="False" />
                <!-- Top strip: covers the visible negative-Y area (above canvas origin,
                     right of the left strip so they do not double-paint the corner) -->
                <Rectangle x:Name="NegSpaceTop"
                           Fill="{DynamicResource NegativeSpaceBrush}"
                           IsHitTestVisible="False"
                           IsVisible="False" />
            </Canvas>
            </Panel>
            </Border>

            <!-- Splitter right - hidden when properties panel is not visible -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          IsVisible="{Binding IsPropertiesPanelVisible}"
                          ResizeDirection="Columns"
                          Background="Transparent"
                          HorizontalAlignment="Stretch"/>

            <!-- Properties panel -->
            <Border Grid.Column="2"
                    Width="240"
                    IsVisible="{Binding IsPropertiesPanelVisible}"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    Background="{DynamicResource PanelBackgroundBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Properties"
                               FontWeight="SemiBold"
                               Margin="8,8,8,4"/>

                    <Separator DockPanel.Dock="Top" Margin="8,4"/>

                    <!-- Empty state hint -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Select a node to view its properties."
                               IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}"
                               Opacity="0.5"
                               Margin="8,4"
                               TextWrapping="Wrap"/>

                    <!-- Node-specific properties -->
                    <ScrollViewer IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ContentControl x:Name="NodePropertiesContent" Content="{Binding SelectedNode}">
                            <ContentControl.DataTemplates>

                                <!-- Number Producer properties -->
                                <DataTemplate DataType="models:NumberProducerNode">
                                    <StackPanel Margin="8,4" Spacing="6">
                                        <TextBlock Text="{Binding NodeType}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Name"/>
                                        <TextBox x:Name="NodeNameTextBox"
                                                 Text="{Binding Name}"
                                                 Classes.nameError="{Binding HasNameError}"/>
                                        <TextBlock Text="Duplicate node name"
                                                   IsVisible="{Binding HasNameError}"
                                                   Foreground="Red" FontSize="11"/>
                                        <TextBlock Text="Value"/>
                                        <NumericUpDown Value="{Binding Value}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- Number Reporter properties -->
                                <DataTemplate DataType="models:NumberReporterNode">
                                    <StackPanel Margin="8,4" Spacing="6">
                                        <TextBlock Text="{Binding NodeType}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Name"/>
                                        <TextBox x:Name="NodeNameTextBox"
                                                 Text="{Binding Name}"
                                                 Classes.nameError="{Binding HasNameError}"/>
                                        <TextBlock Text="Duplicate node name"
                                                   IsVisible="{Binding HasNameError}"
                                                   Foreground="Red" FontSize="11"/>
                                        <TextBlock Text="Value (read-only)"/>
                                        <TextBox Text="{Binding Value, StringFormat='0.##'}"
                                                 IsReadOnly="True"/>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- Arithmetic Transform properties -->
                                <DataTemplate DataType="models:ArithmeticTransformNode">
                                    <StackPanel Margin="8,4" Spacing="6">
                                        <TextBlock Text="{Binding NodeType}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Name"/>
                                        <TextBox x:Name="NodeNameTextBox"
                                                 Text="{Binding Name}"
                                                 Classes.nameError="{Binding HasNameError}"/>
                                        <TextBlock Text="Duplicate node name"
                                                   IsVisible="{Binding HasNameError}"
                                                   Foreground="Red" FontSize="11"/>
                                        <TextBlock Text="Operation"/>
                                        <ComboBox ItemsSource="{x:Static models:ArithmeticOperationValues.All}"
                                                  SelectedItem="{Binding Operation}"
                                                  HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="Input A"/>
                                        <NumericUpDown Value="{Binding InputA}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                        <TextBlock Text="Input B"/>
                                        <NumericUpDown Value="{Binding InputB}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                        <TextBlock Text="Result (read-only)"/>
                                        <TextBox Text="{Binding Result, StringFormat='0.##'}"
                                                 IsReadOnly="True"/>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- Random Number Generator properties -->
                                <DataTemplate DataType="models:RandomNumberGeneratorNode">
                                    <StackPanel Margin="8,4" Spacing="6">
                                        <TextBlock Text="{Binding NodeType}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Name"/>
                                        <TextBox x:Name="NodeNameTextBox"
                                                 Text="{Binding Name}"
                                                 Classes.nameError="{Binding HasNameError}"/>
                                        <TextBlock Text="Duplicate node name"
                                                   IsVisible="{Binding HasNameError}"
                                                   Foreground="Red" FontSize="11"/>
                                        <TextBlock Text="Min Value"/>
                                        <NumericUpDown Value="{Binding MinValue}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                        <TextBlock Text="Max Value"/>
                                        <NumericUpDown Value="{Binding MaxValue}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                        <TextBlock Text="Last Generated Value (read-only)"/>
                                        <TextBox Text="{Binding Value, StringFormat='0.##'}"
                                                 IsReadOnly="True"/>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- Pass Filter properties -->
                                <DataTemplate DataType="models:PassFilterNode">
                                    <StackPanel Margin="8,4" Spacing="6">
                                        <TextBlock Text="{Binding NodeType}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Name"/>
                                        <TextBox x:Name="NodeNameTextBox"
                                                 Text="{Binding Name}"
                                                 Classes.nameError="{Binding HasNameError}"/>
                                        <TextBlock Text="Duplicate node name"
                                                   IsVisible="{Binding HasNameError}"
                                                   Foreground="Red" FontSize="11"/>
                                        <TextBlock Text="Filter Type"/>
                                        <ComboBox ItemsSource="{x:Static models:FilterTypeValues.All}"
                                                  SelectedItem="{Binding FilterType}"
                                                  HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="Threshold"/>
                                        <NumericUpDown Value="{Binding Threshold}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                        <TextBlock Text="Upper Threshold (MidPass only)"/>
                                        <NumericUpDown Value="{Binding UpperThreshold}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                    </StackPanel>
                                </DataTemplate>

                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>

</Window>
