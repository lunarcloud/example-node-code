<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaNodeEditor.ViewModels"
        xmlns:models="using:AvaloniaNodeEditor.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nodify="clr-namespace:NodifyM.Avalonia.Controls;assembly=NodifyM.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        x:Class="AvaloniaNodeEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Avalonia Node Editor">

    <!-- Connector display templates with labels -->
    <Window.Resources>
        <DataTemplate x:Key="InputConnectorTemplate" x:DataType="vm:ConnectorViewModel">
            <StackPanel Orientation="Horizontal">
                <nodify:Connector IsConnected="{Binding IsConnected}"
                                  Anchor="{Binding Anchor, Mode=TwoWay}" />
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           FontSize="12" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="OutputConnectorTemplate" x:DataType="vm:ConnectorViewModel">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"
                           FontSize="12" />
                <nodify:Connector IsConnected="{Binding IsConnected}"
                                  Anchor="{Binding Anchor, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewGraphCommand}"/>
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyNodeCommand}"/>
        <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteNodeCommand}"/>
        <KeyBinding Gesture="Delete" Command="{Binding DeleteNodeCommand}"/>
    </Window.KeyBindings>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Ribbon Toolbar -->
        <Border DockPanel.Dock="Top"
                Classes="ribbon-container">
            <StackPanel Orientation="Horizontal" Spacing="0">

                <!-- File Group -->
                <Border Classes="ribbon-group">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom"
                                   Text="File"
                                   Classes="ribbon-group-label"/>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="ribbon-button"
                                    Command="{Binding NewGraphCommand}"
                                    ToolTip.Tip="New graph (Ctrl+N)">
                                New
                            </Button>
                            <Button Classes="ribbon-button"
                                    Click="OnSaveClick"
                                    ToolTip.Tip="Save graph (Ctrl+S)">
                                Save
                            </Button>
                            <Button Classes="ribbon-button"
                                    Click="OnLoadClick"
                                    ToolTip.Tip="Open graph (Ctrl+O)">
                                Open
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Edit Group -->
                <Border Classes="ribbon-group">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom"
                                   Text="Edit"
                                   Classes="ribbon-group-label"/>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="ribbon-button"
                                    Command="{Binding CopyNodeCommand}"
                                    ToolTip.Tip="Copy selected node (Ctrl+C)">
                                Copy
                            </Button>
                            <Button Classes="ribbon-button"
                                    Command="{Binding PasteNodeCommand}"
                                    ToolTip.Tip="Paste copied node (Ctrl+V)">
                                Paste
                            </Button>
                            <Button Classes="ribbon-button"
                                    Command="{Binding DeleteNodeCommand}"
                                    ToolTip.Tip="Delete selected node (Del)">
                                Delete
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Nodes Group -->
                <Border Classes="ribbon-group">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom"
                                   Text="Nodes"
                                   Classes="ribbon-group-label"/>
                        <DropDownButton Classes="ribbon-button"
                                        x:CompileBindings="False"
                                        ToolTip.Tip="Add a new node to the canvas">
                            Add Node
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="Number Producer"
                                              Command="{Binding AddNodeCommand}"
                                              CommandParameter="Number Producer"/>
                                    <MenuItem Header="Number Reporter"
                                              Command="{Binding AddNodeCommand}"
                                              CommandParameter="Number Reporter"/>
                                    <MenuItem Header="Arithmetic Transform"
                                              Command="{Binding AddNodeCommand}"
                                              CommandParameter="Arithmetic Transform"/>
                                    <MenuItem Header="Random Number Generator"
                                              Command="{Binding AddNodeCommand}"
                                              CommandParameter="Random Number Generator"/>
                                    <MenuItem Header="Pass Filter"
                                              Command="{Binding AddNodeCommand}"
                                              CommandParameter="Pass Filter"/>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </DockPanel>
                </Border>

                <!-- View Group -->
                <Border Classes="ribbon-group">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom"
                                   Text="View"
                                   Classes="ribbon-group-label"/>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <ToggleButton Classes="ribbon-button"
                                          IsChecked="{Binding IsPropertiesPanelVisible}"
                                          ToolTip.Tip="Show or hide the node properties panel">
                                Properties
                            </ToggleButton>
                            <Button Classes="ribbon-button"
                                    ToolTip.Tip="View and edit the graph name and version">
                                Graph Info
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel Spacing="6" Width="200" Margin="8">
                                            <TextBlock Text="Graph Properties" FontWeight="SemiBold"/>
                                            <TextBlock Text="Name" FontSize="11"/>
                                            <TextBox Text="{Binding GraphName}" Watermark="Untitled"/>
                                            <TextBlock Text="Version" FontSize="11"/>
                                            <TextBox Text="{Binding GraphVersion}" Watermark="0.0.0"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Help Group -->
                <Border Classes="ribbon-group">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom"
                                   Text="Help"
                                   Classes="ribbon-group-label"/>
                        <Button Classes="ribbon-button"
                                Click="OnAboutClick"
                                ToolTip.Tip="About Avalonia Node Editor">
                            About
                        </Button>
                    </DockPanel>
                </Border>

            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Toolbox -->
                <ColumnDefinition Width="200" MinWidth="140" MaxWidth="360"/>
                <ColumnDefinition Width="4"/>
                <!-- Node canvas -->
                <ColumnDefinition Width="*"/>
                <!-- Right splitter - Auto so it collapses when properties panel is hidden -->
                <ColumnDefinition Width="Auto"/>
                <!-- Properties panel - Auto so it collapses when hidden -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Toolbox -->
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    Background="{DynamicResource PanelBackgroundBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Toolbox"
                               FontWeight="SemiBold"
                               Margin="8,8,8,4"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Drag to canvas or double-click to add"
                               FontSize="11"
                               Opacity="0.6"
                               Margin="8,0,8,6"
                               TextWrapping="Wrap"/>
                    <ListBox x:Name="ToolboxList"
                             ItemsSource="{Binding ToolboxItems}"
                             DoubleTapped="OnToolboxDoubleTapped"
                             x:CompileBindings="False">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Splitter left -->
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="Transparent"
                          HorizontalAlignment="Stretch"/>

            <!-- Node editor canvas -->
            <!-- Border provides explicit layout bounds so NodifyEditor's infinite Canvas
                 is clipped to this Grid column and cannot bleed over adjacent panels. -->
            <Border Grid.Column="2" ClipToBounds="True">
            <nodify:NodifyEditor x:Name="NodeEditorControl"
                                 x:CompileBindings="False"
                                 ItemsSource="{Binding Nodes}"
                                 Connections="{Binding Connections}"
                                 ConnectionCompletedCommand="{Binding ConnectionCompletedCommand}"
                                 RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                                 DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}">

                <!-- Template for each node on the canvas -->
                <nodify:NodifyEditor.ItemTemplate>
                    <DataTemplate>
                        <nodify:Node Header="{Binding Name}"
                                     Location="{Binding Location, Mode=TwoWay}"
                                     IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                     Input="{Binding Inputs}"
                                     Output="{Binding Outputs}"
                                     InputConnectorTemplate="{StaticResource InputConnectorTemplate}"
                                     OutputConnectorTemplate="{StaticResource OutputConnectorTemplate}" />
                    </DataTemplate>
                </nodify:NodifyEditor.ItemTemplate>

                <!-- Template for drawn connections -->
                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate>
                        <nodify:Connection Source="{Binding Source.Anchor}"
                                           Target="{Binding Target.Anchor}"
                                           DisconnectCommand="{Binding $parent[nodify:NodifyEditor].RemoveConnectionCommand}" />
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>

                <!-- Template for the in-progress (pending) connection -->
                <nodify:NodifyEditor.PendingConnectionTemplate>
                    <DataTemplate>
                        <nodify:PendingConnection AllowOnlyConnectors="True" />
                    </DataTemplate>
                </nodify:NodifyEditor.PendingConnectionTemplate>
            </nodify:NodifyEditor>
            </Border>

            <!-- Splitter right - hidden when properties panel is not visible -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          IsVisible="{Binding IsPropertiesPanelVisible}"
                          ResizeDirection="Columns"
                          Background="Transparent"
                          HorizontalAlignment="Stretch"/>

            <!-- Properties panel -->
            <Border Grid.Column="4"
                    Width="240"
                    IsVisible="{Binding IsPropertiesPanelVisible}"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    Background="{DynamicResource PanelBackgroundBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Properties"
                               FontWeight="SemiBold"
                               Margin="8,8,8,4"/>

                    <Separator DockPanel.Dock="Top" Margin="8,4"/>

                    <!-- Empty state hint -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Select a node to view its properties."
                               IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}"
                               Opacity="0.5"
                               Margin="8,4"
                               TextWrapping="Wrap"/>

                    <!-- Node-specific properties -->
                    <ScrollViewer IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ContentControl Content="{Binding SelectedNode}">
                            <ContentControl.DataTemplates>

                                <!-- Number Producer properties -->
                                <DataTemplate DataType="models:NumberProducerNode">
                                    <StackPanel Margin="8,4" Spacing="6">
                                        <TextBlock Text="{Binding NodeType}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Name"/>
                                        <TextBox Text="{Binding Name}"
                                                 Classes.nameError="{Binding HasNameError}"/>
                                        <TextBlock Text="Duplicate node name"
                                                   IsVisible="{Binding HasNameError}"
                                                   Foreground="Red" FontSize="11"/>
                                        <TextBlock Text="Value"/>
                                        <NumericUpDown Value="{Binding Value}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- Number Reporter properties -->
                                <DataTemplate DataType="models:NumberReporterNode">
                                    <StackPanel Margin="8,4" Spacing="6">
                                        <TextBlock Text="{Binding NodeType}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Name"/>
                                        <TextBox Text="{Binding Name}"
                                                 Classes.nameError="{Binding HasNameError}"/>
                                        <TextBlock Text="Duplicate node name"
                                                   IsVisible="{Binding HasNameError}"
                                                   Foreground="Red" FontSize="11"/>
                                        <TextBlock Text="Value (read-only)"/>
                                        <TextBox Text="{Binding Value, StringFormat='0.##'}"
                                                 IsReadOnly="True"/>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- Arithmetic Transform properties -->
                                <DataTemplate DataType="models:ArithmeticTransformNode">
                                    <StackPanel Margin="8,4" Spacing="6">
                                        <TextBlock Text="{Binding NodeType}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Name"/>
                                        <TextBox Text="{Binding Name}"
                                                 Classes.nameError="{Binding HasNameError}"/>
                                        <TextBlock Text="Duplicate node name"
                                                   IsVisible="{Binding HasNameError}"
                                                   Foreground="Red" FontSize="11"/>
                                        <TextBlock Text="Operation"/>
                                        <ComboBox ItemsSource="{x:Static models:ArithmeticOperationValues.All}"
                                                  SelectedItem="{Binding Operation}"
                                                  HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="Input A"/>
                                        <NumericUpDown Value="{Binding InputA}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                        <TextBlock Text="Input B"/>
                                        <NumericUpDown Value="{Binding InputB}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                        <TextBlock Text="Result (read-only)"/>
                                        <TextBox Text="{Binding Result, StringFormat='0.##'}"
                                                 IsReadOnly="True"/>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- Random Number Generator properties -->
                                <DataTemplate DataType="models:RandomNumberGeneratorNode">
                                    <StackPanel Margin="8,4" Spacing="6">
                                        <TextBlock Text="{Binding NodeType}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Name"/>
                                        <TextBox Text="{Binding Name}"
                                                 Classes.nameError="{Binding HasNameError}"/>
                                        <TextBlock Text="Duplicate node name"
                                                   IsVisible="{Binding HasNameError}"
                                                   Foreground="Red" FontSize="11"/>
                                        <TextBlock Text="Min Value"/>
                                        <NumericUpDown Value="{Binding MinValue}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                        <TextBlock Text="Max Value"/>
                                        <NumericUpDown Value="{Binding MaxValue}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                        <TextBlock Text="Last Generated Value (read-only)"/>
                                        <TextBox Text="{Binding Value, StringFormat='0.##'}"
                                                 IsReadOnly="True"/>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- Pass Filter properties -->
                                <DataTemplate DataType="models:PassFilterNode">
                                    <StackPanel Margin="8,4" Spacing="6">
                                        <TextBlock Text="{Binding NodeType}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Name"/>
                                        <TextBox Text="{Binding Name}"
                                                 Classes.nameError="{Binding HasNameError}"/>
                                        <TextBlock Text="Duplicate node name"
                                                   IsVisible="{Binding HasNameError}"
                                                   Foreground="Red" FontSize="11"/>
                                        <TextBlock Text="Filter Type"/>
                                        <ComboBox ItemsSource="{x:Static models:FilterTypeValues.All}"
                                                  SelectedItem="{Binding FilterType}"
                                                  HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="Threshold"/>
                                        <NumericUpDown Value="{Binding Threshold}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                        <TextBlock Text="Upper Threshold (MidPass only)"/>
                                        <NumericUpDown Value="{Binding UpperThreshold}"
                                                       FormatString="0.##"
                                                       Increment="0.1"/>
                                    </StackPanel>
                                </DataTemplate>

                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>

</Window>
